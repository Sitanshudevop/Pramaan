# Pramaan Environment Configuration

# Application
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite file path)
DATABASE_URL=sqlite:///./backend/pramaan.db

# AI Provider Configuration
# Set to 'gemini' for Google Gemini, or leave empty/set to 'null' for deterministic-only mode
AI_PROVIDER=null
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional override for Gemini API endpoint
GEMINI_API_URL=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Confidential Mode Default (0 = off, 1 = on)
CONFIDENTIAL_MODE_DEFAULT=0

