        "title": "Product name casing & typography",
        "text": "Always write 'Masala Chai' in Title Case and 'Kettle & Co.' with an ampersand (&), never 'Kettle and Co' or 'Kettle & company'.",
        "banned_terms": ["Kettle and Co", "Kettle & company"],
        "severity": "Major",
